# Copia este archivo a `.env` y rellena los valores necesarios.

# --- Base de datos ---
# Local (SQLite), estado actual:
DATABASE_URL="file:./dev.db"
# Producción (Fase 2, Neon Postgres): sustituye DATABASE_URL por la cadena POOLED
# y rellena DIRECT_DATABASE_URL con la cadena DIRECT (sin pooler) para migraciones.
DIRECT_DATABASE_URL=""

# --- NextAuth ---
# `trustHost: true` vive en src/auth.ts. Si el proxy reenvía un Host correcto
# (Vercel, nginx con proxy_set_header Host), Auth.js deduce el origen y NO hace
# falta AUTH_URL/NEXTAUTH_URL: déjalas SIN definir. OJO: un valor vacío
# (`AUTH_URL=""`) es no-nullish y APAGA trustHost. En túneles que reescriben el
# Host a localhost (p. ej. `cloudflared --url`) hay que fijar AUTH_URL al origen
# público del túnel; si no, el login redirige a localhost y vuelve a /login.
NEXTAUTH_SECRET="dev-secret-change-me-in-production"
# NextAuth v5 (necesario en Vercel)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# --- 2FA TOTP ---
# Clave AES-256-GCM de 32 bytes en base64. Sin ella, la sección Security
# muestra que 2FA no está disponible (el resto de la app sigue funcionando).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarda una copia: si se pierde, los secretos TOTP existentes no se pueden descifrar.
TOTP_ENCRYPTION_KEY=""

# --- Backblaze B2 (S3-compatible) ---
# Bucket privado: las imágenes se sirven vía /api/images.
# Endpoint S3 del bucket: https://s3.<region>.backblazeb2.com (ej. https://s3.eu-central-003.backblazeb2.com)
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET=""
B2_ENDPOINT=""
B2_REGION=""

# --- Sitio ---
# URL canónica para metadata, Open Graph y sitemap (sin barra final).
# En Vercel cae automáticamente a VERCEL_URL si no se define.
NEXT_PUBLIC_SITE_URL="http://localhost:9002"

# --- RAWG (autocompletado de juegos, opcional) ---
# Sin RAWG_API_KEY el formulario de subida/edición sigue funcionando con el
# campo libre y no se llama a la API. La key vive SOLO en el servidor: el
# cliente habla con /api/games/search.
RAWG_API_KEY=""
RAWG_API_URL="https://api.rawg.io/api"

# --- IGDB (fallback de autocompletado, opcional) ---
# Si RAWG está configurado pero falla (caída), se intenta IGDB para no dejar el
# autocompletado vacío. Sin estas dos variables el fallback queda desactivado.
# Credenciales de una app de Twitch (https://dev.twitch.tv/console/apps,
# Client Type: Confidential). La API gratuita de IGDB es solo uso NO comercial.
# Las sugerencias de IGDB rellenan el título como texto manual: su id no se
# guarda como gameId (el id canónico sigue siendo de RAWG).
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""
IGDB_TIMEOUT_MS="4000"

# --- Triage IA (NaN, opcional) ---
# Sin NAN_API_KEY el screening IA queda desactivado y nada cambia.
# Endpoint OpenAI-compatible; se llama a <NAN_API_URL>/chat/completions.
NAN_API_KEY=""
NAN_API_URL="https://api.nan.builders/v1"
NAN_MODEL="NaN"
# Timeout en ms por clasificación.
NAN_TIMEOUT_MS="20000"
# Si es "true", un veredicto UNSAFE en el upload oculta la placa directamente
# en lugar de mandarla a revisión.
NAN_AUTO_HIDE="false"
# Solo para desarrollo: SAFE|REVIEW|UNSAFE devuelve un veredicto fijo sin
# llamar a la API. Permite probar el flujo de moderación sin NAN_API_KEY.
NAN_FAKE_VERDICT=""

# --- Avisos de moderación por Telegram (opcional) ---
# Sin estas dos variables no se envía nada. Se avisa cuando la IA marca una
# subida o un reporte con REVIEW/UNSAFE, con botones para moderar al momento.
# Token de @BotFather y chat id del moderador (o grupo).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Secreto del webhook: Telegram lo manda en X-Telegram-Bot-Api-Secret-Token.
# Déjalo vacío en local (sin webhook) y rellénalo en producción.
TELEGRAM_WEBHOOK_SECRET=""
# En local, sin URL pública, activa el long-polling (getUpdates) para que los
# botones inline funcionen sin túnel: `pnpm dev` arranca el poller solo. En
# producción NO se define: allí se usa el webhook de /api/telegram. Telegram no
# permite webhook y getUpdates a la vez (error 409).
TELEGRAM_POLLING=""

# --- Rate limiting compartido (opcional) ---
# Sin estas variables el limitador usa memoria por proceso (vale para local y
# una sola instancia). Con Upstash los contadores se comparten entre todas las
# instancias serverless: crea una base Redis en https://console.upstash.com y
# copia la REST URL y el token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Email transaccional ---
# smtp | ethereal | console | memory.
# Vacío = smtp si hay credenciales SMTP; si no, console (imprime el enlace en
# la consola del servidor, perfecto para local). memory solo para tests.
EMAIL_TRANSPORT=""
# Host SMTP explícito. Ejemplos:
#   Resend (recomendado): smtp.resend.com:587, user "resend", pass = API key.
#   Brevo (alternativa):  smtp-relay.brevo.com:587, user = cuenta, pass = SMTP key.
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""
# Remitente verificado en el proveedor (dominio con DKIM/SPF en producción).
EMAIL_FROM="Platinum Showcase <no-reply@localhost>"
EMAIL_REPLY_TO=""
# Dominios que nunca se bloquean aunque estén en la lista de desechables
# (falsos positivos), separados por comas.
EMAIL_DOMAIN_ALLOWLIST=""
