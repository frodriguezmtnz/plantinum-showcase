# Copia este archivo a `.env` y rellena los valores necesarios.

# --- Base de datos ---
# Local (SQLite), estado actual:
DATABASE_URL="file:./dev.db"
# Producción (Fase 2, Neon Postgres): sustituye DATABASE_URL por la cadena POOLED
# y rellena DIRECT_DATABASE_URL con la cadena DIRECT (sin pooler) para migraciones.
DIRECT_DATABASE_URL=""

# --- NextAuth ---
# `trustHost: true` vive en src/auth.ts. Si el proxy reenvía un Host correcto
# (Vercel, nginx con proxy_set_header Host), Auth.js deduce el origen y NO hace
# falta AUTH_URL/NEXTAUTH_URL: déjalas SIN definir. OJO: un valor vacío
# (`AUTH_URL=""`) es no-nullish y APAGA trustHost. En túneles que reescriben el
# Host a localhost (p. ej. `cloudflared --url`) hay que fijar AUTH_URL al origen
# público del túnel; si no, el login redirige a localhost y vuelve a /login.
NEXTAUTH_SECRET="dev-secret-change-me-in-production"
# NextAuth v5 (necesario en Vercel)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# --- Backblaze B2 (S3-compatible) ---
# Bucket privado: las imágenes se sirven vía /api/images.
# Endpoint S3 del bucket: https://s3.<region>.backblazeb2.com (ej. https://s3.eu-central-003.backblazeb2.com)
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET=""
B2_ENDPOINT=""
B2_REGION=""

# --- Sitio ---
# URL canónica para metadata, Open Graph y sitemap (sin barra final).
# En Vercel cae automáticamente a VERCEL_URL si no se define.
NEXT_PUBLIC_SITE_URL="http://localhost:9002"
