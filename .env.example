# Copia este archivo a `.env` y rellena los valores necesarios.
# Ninguna variable es obligatoria para el desarrollo básico de la app.

# Local SQLite
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:9002"
NEXTAUTH_SECRET="dev-secret-change-me-in-production"

# Backblaze B2 (S3-compatible). Bucket privado: las imágenes se sirven vía /api/images.
# Endpoint S3 del bucket: https://s3.<region>.backblazeb2.com (ej. https://s3.eu-central-003.backblazeb2.com)
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET=""
B2_ENDPOINT=""
B2_REGION=""