generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  PLATINUM
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

// PUBLISHED is the happy path; UNDER_REVIEW keeps a plate off the public lists
// while a moderator decides; HIDDEN means it was taken down.
enum ModerationStatus {
  PUBLISHED
  UNDER_REVIEW
  HIDDEN
}

enum ReportReason {
  SEXUAL
  VIOLENT
  OFF_CONTEXT
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

// Screening verdict for a content-addressed screenshot. SAFE keeps the plate
// published, REVIEW asks a moderator to look, UNSAFE is the strongest signal.
enum AiVerdictLabel {
  SAFE
  REVIEW
  UNSAFE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  plan          Plan      @default(FREE)
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  platinums Platinum[]
  votes     Vote[]    @relation("UserVotes")
  reports   Report[]
}

model Vote {
  id         String   @id @default(cuid())
  platinumId String
  userId     String
  period     String
  createdAt  DateTime @default(now())

  platinum Platinum @relation("PlatinumVotes", fields: [platinumId], references: [id], onDelete: Cascade)
  user     User     @relation("UserVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platinumId])
  @@index([platinumId])
  @@index([platinumId, period])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Platinum {
  id           String   @id @default(cuid())
  hash         String
  gameName     String
  platform     String
  platinumDate DateTime
  isSpoiler    Boolean  @default(false)
  comment      String?
  userId            String
  votes             Int      @default(0)
  monthlyVotes      Int      @default(0)
  monthlyVotesMonth String?
  imageUrl          String
  imageHint         String
  width             Int
  height            Int
  watermarked       Boolean    @default(true)
  moderationStatus  ModerationStatus @default(PUBLISHED)
  createdAt         DateTime   @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteRecords Vote[]   @relation("PlatinumVotes")
  reports     Report[]

  @@unique([userId, hash])
  @@index([monthlyVotesMonth, monthlyVotes])
  @@index([moderationStatus])
}

// One report per user per plate: re-reporting updates the existing row.
model Report {
  id         String       @id @default(cuid())
  platinumId String
  userId     String
  reason     ReportReason
  message    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  platinum Platinum @relation(fields: [platinumId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platinumId])
  @@index([status])
  @@index([platinumId])
}

// Frozen final ranking of a closed calendar month. Denormalised on purpose:
// edits or deletions of a Platinum after the month closes must not rewrite
// history. platinumId is a plain nullable reference (no FK) so a deleted
// plate leaves its frozen row intact; deletePlatinum clears the link only.
model MonthlyResult {
  id         String   @id @default(cuid())
  period     String
  rank       Int
  votes      Int
  platinumId String?
  gameName   String
  imageUrl   String
  imageHint  String
  width      Int
  height     Int
  platform   String
  isSpoiler  Boolean
  username   String
  avatarUrl  String
  createdAt  DateTime @default(now())

  @@unique([period, rank])
  @@index([period, votes])
}

// Cached AI screening of a screenshot, keyed by its content hash so the same
// image is only classified once. Standalone (no FK) on purpose: the verdict is
// about the bytes, not about one specific plate.
model ImageVerdict {
  id         String         @id @default(cuid())
  hash       String         @unique
  label      AiVerdictLabel
  category   String?
  confidence Float?
  summary    String?
  provider   String
  model      String
  raw        Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}