generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  PLATINUM
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

// One-shot tokens for the email flows. Only the SHA-256 hash is stored; the raw
// token only travels in the email link.
enum EmailTokenKind {
  PASSWORD_RESET
  EMAIL_VERIFY
  EMAIL_CHANGE
}

// PUBLISHED is the happy path; UNDER_REVIEW keeps a plate off the public lists
// while a moderator decides; HIDDEN means it was taken down.
enum ModerationStatus {
  PUBLISHED
  UNDER_REVIEW
  HIDDEN
}

enum ReportReason {
  SEXUAL
  VIOLENT
  OFF_CONTEXT
  SPAM
  OTHER
  APPEAL
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

// Owner-facing messages raised by the moderation flow (a plate that stops
// being public, or a manual review that needs their attention), plus the
// moderator-facing queue items (appeals, flags and user reports) and the
// social notices: someone started following you, or a hunter you follow
// published a platinum.
enum NotificationKind {
  PLATE_HIDDEN
  PLATE_UNDER_REVIEW
  APPEAL_RESOLVED
  APPEAL_RECEIVED
  PLATE_FLAGGED
  REPORT_RECEIVED
  NEW_FOLLOWER
  FOLLOWED_PLATE
}

// Screening verdict for a content-addressed screenshot. SAFE keeps the plate
// published, REVIEW asks a moderator to look, UNSAFE is the strongest signal.
enum AiVerdictLabel {
  SAFE
  REVIEW
  UNSAFE
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  username              String?   @unique
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  // Bumped on password change/reset so every JWT issued before it is rejected.
  sessionVersion        Int       @default(0)
  plan                  Plan      @default(FREE)
  role                  Role      @default(USER)
  // Public profile extras, edited from /settings.
  bio                   String?
  psnProfileUrl         String?
  // Handle changes are limited to once every 12 months.
  usernameChangedAt     DateTime?
  // Opt-out for the "a hunter you follow posted a platinum" notices.
  notifyFollowedUploads Boolean   @default(true)
  // Confirmed NSFW/serious moderation hits. Escalates the upload flow.
  strikes               Int       @default(0)
  createdAt             DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  platinums       Platinum[]
  votes           Vote[]            @relation("UserVotes")
  reports         Report[]
  notifications   Notification[]
  passwordHistory PasswordHistory[]
  // One-way social graph: who this user follows and who follows them.
  following       Follow[]          @relation("Following")
  followers       Follow[]          @relation("Followers")
  // Trophy-site profiles (one per provider), e.g. PSNProfiles + Exophase.
  profileLinks    ProfileLink[]
  // One-shot password reset / email verification tokens.
  emailTokens     EmailToken[]
}

// A trophy-site profile for a user. One row per provider: the PSN handle is
// the same, the site showing it is what changes.
model ProfileLink {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  handle    String
  url       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// Handles that used to belong to an account (renamed or deleted). They stay
// reserved forever so old links never point at a different person.
model UsernameHistory {
  id            String   @id @default(cuid())
  username      String
  usernameLower String   @unique
  userId        String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

// The last few passwords a user cannot reuse. We store the *previous* hashes
// (never plaintext) and prune to PASSWORD_HISTORY_LIMIT on every change.
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// One active token per (user, kind): requesting a fresh link replaces the
// previous one, and consuming it marks it used so a replay fails.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  kind      EmailTokenKind
  tokenHash String         @unique
  // Only EMAIL_CHANGE uses it: the address the account will switch to.
  pendingEmail String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

model Vote {
  id         String   @id @default(cuid())
  platinumId String
  userId     String
  period     String
  createdAt  DateTime @default(now())

  platinum Platinum @relation("PlatinumVotes", fields: [platinumId], references: [id], onDelete: Cascade)
  user     User     @relation("UserVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platinumId])
  @@index([platinumId])
  @@index([platinumId, period])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Platinum {
  id                String           @id @default(cuid())
  hash              String
  gameName          String
  gameId            Int?
  platform          String
  platinumDate      DateTime
  isSpoiler         Boolean          @default(false)
  comment           String?
  userId            String
  votes             Int              @default(0)
  monthlyVotes      Int              @default(0)
  monthlyVotesMonth String?
  imageUrl          String
  imageHint         String
  width             Int
  height            Int
  watermarked       Boolean          @default(true)
  moderationStatus  ModerationStatus @default(PUBLISHED)
  createdAt         DateTime         @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteRecords Vote[]   @relation("PlatinumVotes")
  reports     Report[]

  @@unique([userId, hash])
  @@index([gameId])
  @@index([monthlyVotesMonth, monthlyVotes])
  @@index([moderationStatus])
  @@index([userId, platinumDate(sort: Desc)])
  @@index([userId, moderationStatus, platinumDate(sort: Desc)])
}

// One report per user per plate: re-reporting updates the existing row.
model Report {
  id         String       @id @default(cuid())
  platinumId String
  userId     String
  reason     ReportReason
  message    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  platinum Platinum @relation(fields: [platinumId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platinumId])
  @@index([status])
  @@index([platinumId])
}

// Frozen final ranking of a closed calendar month. Denormalised on purpose:
// edits or deletions of a Platinum after the month closes must not rewrite
// history. platinumId is a plain nullable reference (no FK) so a deleted
// plate leaves its frozen row intact; deletePlatinum clears the link only.
model MonthlyResult {
  id         String   @id @default(cuid())
  period     String
  rank       Int
  votes      Int
  platinumId String?
  gameName   String
  imageUrl   String
  imageHint  String
  width      Int
  height     Int
  platform   String
  isSpoiler  Boolean
  username   String
  avatarUrl  String
  createdAt  DateTime @default(now())

  @@unique([period, rank])
  @@index([period, votes])
}

// Cached AI screening of an image (screenshot or avatar), keyed by its content
// hash so the same bytes are only classified once. Standalone (no FK) on purpose: the verdict is
// about the bytes, not about one specific plate.
model ImageVerdict {
  id         String         @id @default(cuid())
  hash       String         @unique
  label      AiVerdictLabel
  category   String?
  confidence Float?
  summary    String?
  provider   String
  model      String
  raw        Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// Hashes a moderator confirmed as disallowed. Because screenshots are
// content-addressed, a re-upload of flagged bytes is taken down on arrival,
// before the AI is even asked. Standalone (no FK) like ImageVerdict.
model FlaggedHash {
  hash      String   @id
  reason    String?
  createdAt DateTime @default(now())
}

// In-app message for the owner of a plate that moderation acted on, or a
// social notice. `linkUrl` points at a profile for not-plate notices.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  kind       NotificationKind
  title      String
  body       String?
  platinumId String?
  linkUrl    String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cursor pagination walks (createdAt desc, id desc) for one owner.
  @@index([userId, createdAt, id])
  @@index([userId, readAt])
}

// One-way follow edge. The pair is unique so a double-click can never create
// two rows; deleting either account cleans up both directions.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}
