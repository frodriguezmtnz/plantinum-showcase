generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  PLATINUM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  plan          Plan      @default(FREE)
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  platinums Platinum[]
  votes     Vote[]    @relation("UserVotes")
}

model Vote {
  id         String   @id @default(cuid())
  platinumId String
  userId     String
  period     String
  createdAt  DateTime @default(now())

  platinum Platinum @relation("PlatinumVotes", fields: [platinumId], references: [id], onDelete: Cascade)
  user     User     @relation("UserVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platinumId])
  @@index([platinumId])
  @@index([platinumId, period])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Platinum {
  id           String   @id @default(cuid())
  hash         String
  gameName     String
  platform     String
  platinumDate DateTime
  isSpoiler    Boolean  @default(false)
  comment      String?
  userId            String
  votes             Int      @default(0)
  monthlyVotes      Int      @default(0)
  monthlyVotesMonth String?
  imageUrl          String
  imageHint         String
  width             Int
  height            Int
  watermarked       Boolean    @default(true)
  createdAt         DateTime   @default(now())

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteRecords Vote[] @relation("PlatinumVotes")

  @@unique([userId, hash])
  @@index([monthlyVotesMonth, monthlyVotes])
}

// Frozen final ranking of a closed calendar month. Denormalised on purpose:
// edits or deletions of a Platinum after the month closes must not rewrite
// history. platinumId is a plain nullable reference (no FK) so a deleted
// plate leaves its frozen row intact; deletePlatinum clears the link only.
model MonthlyResult {
  id         String   @id @default(cuid())
  period     String
  rank       Int
  votes      Int
  platinumId String?
  gameName   String
  imageUrl   String
  imageHint  String
  width      Int
  height     Int
  platform   String
  isSpoiler  Boolean
  username   String
  avatarUrl  String
  createdAt  DateTime @default(now())

  @@unique([period, rank])
  @@index([period, votes])
}